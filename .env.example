# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Kayan AI read-only connector
KAYAN_AI_API_URL="https://your-kayan-ai-domain.example"
KAYAN_AI_API_KEY=""
KAYAN_AI_ORGANIZATION_ID=""

# Vercel product connectors. URLs are public; credentials, if a product adds
# an authenticated API later, must be stored as Vercel secrets, never in Git.
KROTAK_API_URL="https://krotak-pro.vercel.app"
KROTAK_HEALTH_PATH="/api/health"
KROTIC_ADMIN_API_URL="https://krotic-admin-app-wine.vercel.app"
KROTIC_ADMIN_HEALTH_PATH="/api/health"
ALMOTHFIN_API_URL="https://almothfin-seven.vercel.app"
ALMOTHFIN_HEALTH_PATH="/api/health"
KAYAN_SOFT_API_URL="https://kayan-soft.online"
KAYAN_SOFT_HEALTH_PATH="/"

# Server-side signing secrets; keep these hidden in the deployment provider
KAYAN_SESSION_SECRET=""
KAYAN_WEBHOOK_SECRET=""

# PostgreSQL target for the planned storage migration
DATABASE_URL=""
DATABASE_SSL="true"
ALLOW_MIGRATION_OVERWRITE="false"
CONNECTOR_TIMEOUT_MS="10000"
